---
/**
 * Presupuesto interactivo — landing + catálogo digital, armado como piezas
 * de lego: cada una suma o resta del total según se marque o no. La tarifa
 * por día no se toca desde acá: vive en TARIFA_POR_DIA, en los datos. Es una
 * herramienta para la reunión, no una página del sitio público: no está
 * enlazada desde la navegación.
 *
 * La selección entera vive en la URL, así que al terminar la reunión se copia
 * el enlace y ése es el presupuesto acordado — sin captura ni PDF de por medio.
 */
import Base from '../modules/Landing/layouts/Base.astro';
import Imprenta from '../modules/Landing/components/Imprenta.astro';
import Logo from '../modules/Landing/components/Logo.astro';
import {
  FASES_PRESUPUESTO,
  COSTOS_RECURRENTES,
  NO_INCLUYE,
  INFORMACION_ADICIONAL,
  NOMBRE_POR_ID,
  TARIFA_POR_DIA,
  PROPUESTA,
} from '../modules/Landing/data/presupuesto';
---

<Base titulo="Cotización — Palsabi" descripcion="Landing y catálogo digital, por piezas.">
  <Imprenta />
  <main id="contenido" class="relative min-h-screen px-5 py-10 sm:px-8 sm:py-14">
    <div class="mx-auto max-w-2xl">
      <div class="flex items-center justify-between">
        <a
          href="/"
          class="volver inline-flex items-center gap-1.5 font-texto text-menudo font-500 text-azul-suave transition-colors duration-200 hover:text-azul"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.5 3 4.5 8l5 5" />
          </svg>
          Volver
        </a>
        <Logo direccion="fila" />
      </div>

      <div class="solo-pantalla margen-quieto etiqueta mt-6 inline-flex items-center gap-2 px-4 py-2">
        <span class="rotulo text-azul-suave">Presupuesto por piezas</span>
      </div>

      <h1 class="mt-4 text-titulo font-700 text-azul">Landing + Catálogo digital</h1>
      <!--
        El documento impreso. En pantalla no existe: la página es la herramienta
        de la reunión, y esto es lo que se lleva el cliente. Las filas están
        todas en el marcado desde el build; el guion solo tapa las que no
        corresponden y completa días y valores.
      -->
      <section id="documento" class="solo-impresion mt-6">
        <div class="flex items-end justify-between gap-6 border-b-[1.5px] border-azul/25 pb-3">
          <p class="rotulo text-azul-suave">Cotización</p>
          <p id="doc-numero" class="font-texto text-menudo font-600 text-azul" />
        </div>

        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3">
          <div>
            <p class="rotulo text-azul-suave">Preparado para</p>
            <p class="mt-0.5 font-texto text-cuerpo text-azul">{PROPUESTA.cliente}</p>
          </div>
          <div>
            <p class="rotulo text-azul-suave">Preparado por</p>
            <p class="mt-0.5 font-texto text-cuerpo text-azul">{PROPUESTA.preparadoPor}</p>
          </div>
          <div>
            <p class="rotulo text-azul-suave">Fecha de emisión</p>
            <p id="doc-fecha" class="mt-0.5 font-texto text-cuerpo text-azul" />
          </div>
          <div>
            <p class="rotulo text-azul-suave">Validez</p>
            <p class="mt-0.5 font-texto text-cuerpo text-azul">{PROPUESTA.validezDias} días desde la emisión</p>
          </div>
        </div>

        <table class="doc-tabla mt-6 w-full">
          <thead>
            <tr>
              <th class="rotulo doc-cabecera text-left text-azul-suave">Concepto</th>
              <th class="rotulo doc-cabecera doc-numero text-azul-suave">Días</th>
              <th class="rotulo doc-cabecera doc-numero text-azul-suave">Valor</th>
            </tr>
          </thead>
          {FASES_PRESUPUESTO.map((fase) => (
            <tbody data-doc-fase>
              <tr>
                <th colspan="3" class="doc-fase font-display text-cuerpo font-600 text-azul">{fase.nombre}</th>
              </tr>
              {fase.items.flatMap((item) =>
                item.tipo === 'opcion'
                  ? item.opciones.map((opcion) => (
                      <tr data-doc-fila data-id={opcion.id}>
                        <td class="doc-concepto">{opcion.nombre}</td>
                        <td data-doc-dias class="doc-concepto doc-numero" />
                        <td data-doc-valor class="doc-concepto doc-numero" />
                      </tr>
                    ))
                  : [
                      <tr data-doc-fila data-id={item.id}>
                        <td class="doc-concepto">
                          {item.nombre}
                          <span data-doc-cantidad class="text-azul-suave" />
                        </td>
                        <td data-doc-dias class="doc-concepto doc-numero" />
                        <td data-doc-valor class="doc-concepto doc-numero" />
                      </tr>,
                    ],
              )}
              <tr data-doc-subtotal>
                <td class="doc-concepto doc-subtotal">Subtotal</td>
                <td data-doc-dias class="doc-concepto doc-numero doc-subtotal" />
                <td data-doc-valor class="doc-concepto doc-numero doc-subtotal" />
              </tr>
            </tbody>
          ))}
          <tfoot>
            <tr class="doc-total">
              <td>Total estimado</td>
              <td id="doc-total-dias" class="doc-numero" />
              <td id="doc-total-valor" class="doc-numero" />
            </tr>
          </tfoot>
        </table>
      </section>
      <p class="solo-pantalla mt-3 max-w-[52ch] font-texto text-guia leading-relaxed text-azul/75">
        Cada pieza es independiente: suma lo que quieras y elimina lo que no. El total de abajo se
        recalcula según lo marcado.
      </p>

      <!-- Piezas. En el documento impreso las reemplaza la tabla de detalle. -->
      <div class="solo-pantalla">
      {
        FASES_PRESUPUESTO.map((fase) => (
          <div class="mt-8">
            <p class="rotulo text-azul-suave">{fase.nombre}</p>
            {fase.nota && (
              <p class="mt-1.5 font-texto text-menudo leading-relaxed text-azul-suave/85">{fase.nota}</p>
            )}
            <div class="mt-3 space-y-2.5">
              {fase.items.map((item) =>
                item.tipo === 'toggle' ? (
                  <button
                    type="button"
                    data-item
                    data-tipo="toggle"
                    data-id={item.id}
                    data-nombre={item.nombre}
                    data-dias={item.dias}
                    data-marcada={item.marcada ? 'true' : 'false'}
                    data-requiere={item.requiere}
                    class:list={[
                      'pieza-boton margen-quieto etiqueta flex w-full items-start gap-3.5 px-4 py-4 text-left transition-all duration-200',
                      item.marcada && 'pieza-activa',
                    ]}
                  >
                    <span class="pieza-check mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md ring-[1.5px] ring-inset ring-azul/40 transition-colors duration-200">
                      <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3.5 8.5l3 3 6-7" />
                      </svg>
                    </span>

                    <span class="min-w-0 flex-1">
                      <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                        <span class="font-display text-cuerpo font-600 text-azul">{item.nombre}</span>
                        <span data-precio-linea class="shrink-0 font-texto text-menudo font-600 text-azul" />
                      </span>
                      <span class="mt-1 block font-texto text-menudo leading-relaxed text-azul/80">
                        {item.descripcion}
                        {item.variantes &&
                          Object.entries(item.variantes).map(([clave, texto]) => (
                            <span data-variante={clave} hidden class="font-600 text-azul">
                              {' '}
                              {texto}
                            </span>
                          ))}
                      </span>
                      <span data-bloqueo hidden class="mt-1.5 inline-block font-texto text-[0.7rem] font-600 text-naranja-hondo">
                        Necesita: {item.requiere ? NOMBRE_POR_ID[item.requiere] : ''}
                      </span>
                    </span>
                  </button>
                ) : item.tipo === 'contador' ? (
                  <div
                    data-item
                    data-tipo="contador"
                    data-id={item.id}
                    data-nombre={item.nombre}
                    data-dias-unidad={item.diasPorUnidad}
                    data-valor={item.inicial}
                    data-min={item.min}
                    data-max={item.max}
                    data-singular={item.unidad.singular}
                    data-plural={item.unidad.plural}
                    data-requiere={item.requiere}
                    class:list={[
                      'pieza-fila margen-quieto etiqueta flex w-full items-start gap-3.5 px-4 py-4 transition-all duration-200',
                      item.inicial > 0 && 'pieza-activa',
                    ]}
                  >
                    <span class="min-w-0 flex-1">
                      <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                        <span class="font-display text-cuerpo font-600 text-azul">{item.nombre}</span>
                        <span data-precio-linea class="shrink-0 font-texto text-menudo font-600 text-azul" />
                      </span>
                      <span class="mt-1 block font-texto text-menudo leading-relaxed text-azul/80">{item.descripcion}</span>
                      <span data-bloqueo hidden class="mt-1.5 inline-block font-texto text-[0.7rem] font-600 text-naranja-hondo">
                        Necesita: {item.requiere ? NOMBRE_POR_ID[item.requiere] : ''}
                      </span>

                      <span class="control-contador mt-3 flex items-center gap-2">
                        <button
                          type="button"
                          data-paso="-1"
                          aria-label={`Quitar ${item.unidad.singular}`}
                          class="paso-boton grid h-8 w-8 place-items-center rounded-lg font-display text-cuerpo font-600 text-azul ring-[1.5px] ring-inset ring-azul/25 transition-colors duration-200"
                        >
                          −
                        </button>
                        <span
                          data-valor-texto
                          class="min-w-[2.5rem] text-center font-display text-cuerpo font-700 text-azul tabular-nums"
                        />
                        <button
                          type="button"
                          data-paso="1"
                          aria-label={`Agregar ${item.unidad.singular}`}
                          class="paso-boton grid h-8 w-8 place-items-center rounded-lg font-display text-cuerpo font-600 text-azul ring-[1.5px] ring-inset ring-azul/25 transition-colors duration-200"
                        >
                          +
                        </button>
                      </span>
                    </span>
                  </div>
                ) : (
                  <div
                    data-item
                    data-tipo="grupo"
                    data-id={item.id}
                    data-inicial={item.inicial}
                    data-requiere={item.requiere}
                    class="grupo-opcion margen-quieto rounded-2xl border-[1.5px] border-azul/20 px-4 py-4 transition-all duration-200"
                  >
                    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                      <p class="font-display text-cuerpo font-600 text-azul">{item.pregunta}</p>
                      <p class="rotulo solo-pantalla shrink-0 text-azul-suave">Elegí una</p>
                    </div>
                    <p data-bloqueo hidden class="mt-1.5 font-texto text-[0.7rem] font-600 text-naranja-hondo">
                      Necesita: {item.requiere ? NOMBRE_POR_ID[item.requiere] : ''}
                    </p>

                    <div class="mt-3 space-y-2">
                      {item.opciones.map((opcion) => (
                        <button
                          type="button"
                          data-opcion
                          data-grupo={item.id}
                          data-id={opcion.id}
                          data-nombre={opcion.nombre}
                          data-dias={opcion.dias}
                          class:list={[
                            'opcion-boton flex w-full items-start gap-3 rounded-xl bg-agua/60 px-3.5 py-3 text-left transition-all duration-200',
                            opcion.id === item.inicial && 'opcion-activa',
                          ]}
                        >
                          <span class="opcion-radio mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full ring-[1.5px] ring-inset ring-azul/40 transition-colors duration-200">
                            <span class="opcion-punto h-2 w-2 rounded-full bg-azul-hondo transition-opacity duration-200" />
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                              <span class="font-display text-cuerpo font-600 text-azul">
                                {opcion.nombre}
                                {opcion.recomendada && (
                                  <span class="rotulo ml-2 inline-block rounded-full bg-naranja px-2 py-0.5 text-azul-hondo">
                                    Recomendada
                                  </span>
                                )}
                              </span>
                              <span data-precio-linea class="shrink-0 font-texto text-menudo font-600 text-azul" />
                            </span>
                            <span class="mt-1 block font-texto text-menudo leading-relaxed text-azul/80">{opcion.descripcion}</span>
                          </span>
                        </button>
                      ))}
                    </div>
                  </div>
                ),
              )}
            </div>
          </div>
        ))
      }
      </div>

      <!-- Tienda con pagos, teaser -->
      <!-- <div class="margen-quieto mt-8 rounded-2xl border-[1.5px] border-dashed border-azul/25 px-5 py-4">
        <p class="rotulo text-azul-suave">Etapa posterior · Tienda en línea</p>
        <p class="mt-1.5 font-texto text-menudo leading-relaxed text-azul/70">
          Se contempla iniciar con transferencia bancaria y DeUna, incorporar PayPhone en una segunda
          instancia y evaluar Kushki o Datafast según el volumen de ventas. Esta etapa se cotiza por
          separado una vez definida la pasarela y no forma parte del total.
        </p>
      </div> -->

      <!-- Costos que no son días de trabajo -->
      <div class="margen-quieto etiqueta mt-4 px-5 py-4">
        <p class="rotulo text-azul-suave">Costos adicionales externos</p>
        <ul class="mt-2 space-y-1.5">
          {
            COSTOS_RECURRENTES.map((costo) => (
              <li class="flex gap-2 font-texto text-menudo leading-relaxed text-azul/75">
                <span class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-azul-suave" />
                <span>{costo}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Lo que no entra -->
      <div class="margen-quieto etiqueta mt-4 px-5 py-4">
        <p class="rotulo text-azul-suave">Lo que este presupuesto no incluye</p>
        <ul class="mt-2 space-y-1.5">
          {
            NO_INCLUYE.map((punto) => (
              <li class="flex gap-2 font-texto text-menudo leading-relaxed text-azul/75">
                <span class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-azul-suave" />
                <span>{punto}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Condiciones del acuerdo -->
      <div class="margen-quieto etiqueta mt-4 px-5 py-4">
        <p class="rotulo text-azul-suave">Información adicional</p>
        <ol class="mt-2 space-y-1.5" style="list-style: lower-alpha inside;">
          {
            INFORMACION_ADICIONAL.map((punto) =>
              typeof punto === 'string' ? (
                <li class="font-texto text-menudo leading-relaxed text-azul/75">{punto}</li>
              ) : (
                <li class="font-texto text-menudo leading-relaxed text-azul/75">
                  {punto.texto}
                  <ul class="mt-1.5 list-disc space-y-1 pl-8">
                    {punto.subpuntos.map((subpunto) => (
                      <li>{subpunto}</li>
                    ))}
                  </ul>
                </li>
              ),
            )
          }
        </ol>
      </div>

      <!-- Total -->
      <div id="resumen-total" class="solo-pantalla hoja-tinta sticky bottom-4 mt-8 flex items-center justify-between gap-4 bg-azul-hondo px-6 py-5 shadow-lg">
        <div class="relative">
          <p id="resumen-cantidad" class="font-texto text-[0.7rem] font-500 uppercase tracking-wide text-agua/60" />
          <p id="resumen-precio" class="mt-1 font-display text-rubro font-700 text-agua" />
        </div>
        <span class="relative shrink-0 rounded-full bg-naranja px-4 py-2 font-display text-menudo font-600 text-azul-hondo">
          Total estimado
        </span>
      </div>

      <div id="acciones" class="mt-4 flex flex-wrap justify-center gap-2.5">
        <button
          type="button"
          id="imprimir"
          class="inline-flex items-center gap-2 rounded-full px-4 py-2 font-texto text-menudo font-600 text-azul-suave ring-[1.5px] ring-inset ring-azul/25 transition-colors duration-200 hover:text-azul"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.5 6V2.5h7V6" />
            <path d="M4.5 12h-2V6h11v6h-2" />
            <path d="M4.5 9.5h7v4h-7z" />
          </svg>
          Impresión de propuesta
        </button>
        <button
          type="button"
          id="guardar"
          class="inline-flex items-center gap-2 rounded-full bg-naranja px-4 py-2 font-texto text-menudo font-600 text-azul-hondo transition-opacity duration-200 hover:opacity-85"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3.5 2.5h7l2.5 2.5v8a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5z" />
            <path d="M5.5 2.5v4h5" />
          </svg>
          <span id="guardar-texto">Guardar selección</span>
        </button>
      </div>

      <p class="mt-4 text-center font-texto text-menudo text-azul-suave/80">
        La produccion de esta propuesta se ejecutara dentro del horario de jornada laboral y dias hábiles. El cronograma final
        depende de los tiempos de revisión y aprobación del cliente.
      </p>

      <section class="solo-impresion doc-firmas mt-10">
        <div>
          <div class="doc-firma" />
          <p class="rotulo mt-2 text-azul-suave">Por el cliente</p>
          <p class="mt-0.5 font-texto text-menudo text-azul">{PROPUESTA.cliente}</p>
        </div>
        <div>
          <div class="doc-firma" />
          <p class="rotulo mt-2 text-azul-suave">Por el desarrollador</p>
          <p class="mt-0.5 font-texto text-menudo text-azul">{PROPUESTA.preparadoPor}</p>
        </div>
      </section>
    </div>
  </main>
</Base>

<style>
  .pieza-check svg {
    opacity: 0;
    color: var(--color-azul-hondo);
    transition: opacity 0.2s ease;
  }
  .pieza-activa {
    opacity: 1;
  }
  .pieza-boton:not(.pieza-activa),
  .pieza-fila:not(.pieza-activa) {
    opacity: 0.62;
  }
  .pieza-activa .pieza-check {
    background: var(--color-naranja);
    border-color: var(--color-naranja);
  }
  .pieza-activa .pieza-check svg {
    opacity: 1;
  }

  .paso-boton:hover:not(:disabled) {
    background: var(--color-naranja);
  }
  .paso-boton:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .opcion-punto {
    opacity: 0;
  }
  .opcion-activa .opcion-radio {
    background: var(--color-naranja);
    box-shadow: inset 0 0 0 1.5px var(--color-naranja);
  }
  .opcion-activa .opcion-punto {
    opacity: 1;
  }
  .opcion-boton:not(.opcion-activa) {
    opacity: 0.7;
  }

  /* Bloqueada: el requisito no está activo. No se puede tocar y no suma. */
  .item-bloqueado {
    opacity: 0.4;
    pointer-events: none;
  }

  .solo-impresion {
    display: none;
  }

  /* Tabla de detalle del documento: filete fino, números alineados. */
  .doc-tabla {
    border-collapse: collapse;
  }
  .doc-cabecera {
    padding-bottom: 0.4rem;
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-azul) 25%, transparent);
  }
  .doc-fase {
    padding: 0.9rem 0 0.3rem;
    text-align: left;
  }
  .doc-concepto {
    padding: 0.4rem 0;
    font-family: var(--font-texto);
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-azul);
    border-bottom: 1px solid color-mix(in srgb, var(--color-azul) 12%, transparent);
    vertical-align: top;
  }
  .doc-numero {
    width: 5.5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .doc-subtotal {
    font-weight: 600;
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-azul) 25%, transparent);
  }
  .doc-total td {
    padding: 0.7rem 0.9rem;
    background: var(--color-azul-hondo);
    color: var(--color-agua);
    font-family: var(--font-display);
    font-weight: 700;
  }
  /* 10px es el radio de `etiqueta`, el mismo de los paneles de condiciones. */
  .doc-total td:first-child {
    border-radius: 10px 0 0 10px;
  }
  .doc-total td:last-child {
    border-radius: 0 10px 10px 0;
  }
  .doc-firma {
    height: 2.6rem;
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-azul) 45%, transparent);
  }
  [data-doc-fila][hidden],
  [data-doc-fase][hidden] {
    display: none;
  }

  /*
   * La propuesta impresa no es la página: es el documento que se lleva el
   * cliente. La lista interactiva desaparece entera y en su lugar queda la
   * tabla de detalle, con carátula arriba y firmas al pie.
   */
  @media print {
    .solo-impresion {
      display: block;
    }
    .doc-firmas {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      break-inside: avoid;
    }

    .solo-pantalla,
    #acciones,
    .volver {
      display: none !important;
    }

    /*
     * La imprenta del fondo va con `position: fixed`, y eso en papel es una
     * lotería: según el navegador se repite en cada hoja o se corta en la
     * primera. El documento se apoya en su propia tipografía y en los paneles
     * de condiciones, que sí llevan su tono de papel. Va con :global porque el
     * elemento lo pone el componente Imprenta, no esta página.
     */
    :global(.fondo) {
      display: none !important;
    }

    /* Sin esto el navegador imprime en blanco sobre blanco lo que lleva fondo. */
    .doc-total td,
    .etiqueta,
    .rotulo {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Ni una fase ni un bloque de condiciones se parten entre dos hojas. */
    [data-doc-fase],
    .margen-quieto {
      break-inside: avoid;
    }

    @page {
      margin: 16mm;
    }
  }
</style>

<script define:vars={{ tarifa: TARIFA_POR_DIA }}>
  const elCantidad = document.getElementById('resumen-cantidad');
  const elPrecio = document.getElementById('resumen-precio');
  const botonImprimir = document.getElementById('imprimir');
  const botonGuardar = document.getElementById('guardar');
  const textoGuardar = document.getElementById('guardar-texto');
  const elDocNumero = document.getElementById('doc-numero');
  const elDocFecha = document.getElementById('doc-fecha');
  const cuerposDoc = Array.from(document.querySelectorAll('[data-doc-fase]'));
  const elDocTotalDias = document.getElementById('doc-total-dias');
  const elDocTotalValor = document.getElementById('doc-total-valor');

  /** Detalle de lo elegido, en orden de página. Lo arma recalcular(). */
  let resumen = [];
  let totalDias = 0;

  const items = Array.from(document.querySelectorAll('[data-item]'));
  const toggles = items.filter((el) => el.dataset.tipo === 'toggle');
  const contadores = items.filter((el) => el.dataset.tipo === 'contador');
  const grupos = items.filter((el) => el.dataset.tipo === 'grupo');
  const opciones = Array.from(document.querySelectorAll('[data-opcion]'));
  const variantes = Array.from(document.querySelectorAll('[data-variante]'));

  /** id → elemento, para resolver los `requiere` sin buscar en el DOM cada vez. */
  const porId = new Map(items.map((el) => [el.dataset.id, el]));
  /** id de opción → id del grupo al que pertenece. */
  const grupoDeOpcion = new Map(opciones.map((el) => [el.dataset.id, el.dataset.grupo]));
  /** id de grupo → id de la opción elegida. */
  const seleccion = new Map(grupos.map((el) => [el.dataset.id, el.dataset.inicial]));

  // Los centavos aparecen solo cuando existen: las horas sueltas dan importes
  // como $12,50 y redondearlos a dólar entero descuadraba el documento.
  function fmt(n) {
    return n.toLocaleString('es-EC', {
      minimumFractionDigits: n % 1 === 0 ? 0 : 2,
      maximumFractionDigits: 2,
    });
  }
  // Tres decimales: hay piezas de tres cuartos de jornada y otras de una hora
  // (un octavo). Con menos, la pantalla mostraría un número y el total sumaría
  // otro. No agrega ceros de más: 2 sigue siendo «2» y 0,75 sigue siendo «0,75».
  function fmtDias(n) {
    return n.toLocaleString('es-EC', { maximumFractionDigits: 3 });
  }
  function etiquetaDias(n) {
    return n === 1 ? 'día' : 'días';
  }

  /**
   * ¿Está activo lo que otra pieza necesita? Se resuelve en cadena: «manejo de
   * imágenes» necesita el panel, el panel necesita el catálogo público. El set
   * `visto` sólo está para que un `requiere` mal escrito no cuelgue la página.
   */
  function activo(id, visto) {
    if (!id || visto.has(id)) return true;
    visto.add(id);

    const grupoDelId = grupoDeOpcion.get(id);
    if (grupoDelId) {
      return seleccion.get(grupoDelId) === id && disponible(grupoDelId, visto);
    }

    const el = porId.get(id);
    if (!el) return true;
    if (el.dataset.tipo === 'toggle') return el.dataset.marcada === 'true' && disponible(id, visto);
    if (el.dataset.tipo === 'contador') return Number(el.dataset.valor) > 0 && disponible(id, visto);
    return disponible(id, visto);
  }

  function disponible(id, visto = new Set()) {
    const el = porId.get(id);
    const requiere = el?.dataset.requiere;
    return requiere ? activo(requiere, visto) : true;
  }

  function pintarBloqueo(el, libre) {
    el.classList.toggle('item-bloqueado', !libre);
    const aviso = el.querySelector('[data-bloqueo]');
    if (aviso) aviso.hidden = libre;
  }

  function recalcular() {
    let dias = 0;
    let cantidad = 0;

    // Toggles. Al perder su requisito se destildan solos, y no se vuelven a
    // marcar cuando el requisito regresa: eso lo decide el cliente.
    toggles.forEach((el) => {
      const libre = disponible(el.dataset.id);
      if (!libre) el.dataset.marcada = 'false';
      const marcada = el.dataset.marcada === 'true';
      el.classList.toggle('pieza-activa', marcada);
      el.disabled = !libre;
      pintarBloqueo(el, libre);

      const diasPieza = Number(el.dataset.dias || 0);
      const linea = el.querySelector('[data-precio-linea]');
      if (linea) linea.textContent = `${fmtDias(diasPieza)} ${etiquetaDias(diasPieza)} · $${fmt(diasPieza * tarifa)}`;

      if (marcada) {
        dias += diasPieza;
        cantidad += 1;
      }
    });

    // Contadores.
    contadores.forEach((el) => {
      const libre = disponible(el.dataset.id);
      if (!libre) el.dataset.valor = '0';
      const valor = Number(el.dataset.valor || 0);
      const porUnidad = Number(el.dataset.diasUnidad || 0);
      const min = Number(el.dataset.min || 0);
      const max = Number(el.dataset.max || 0);
      const diasPieza = valor * porUnidad;

      el.classList.toggle('pieza-activa', valor > 0);
      pintarBloqueo(el, libre);

      const texto = el.querySelector('[data-valor-texto]');
      if (texto) texto.textContent = String(valor);

      el.querySelectorAll('[data-paso]').forEach((boton) => {
        const paso = Number(boton.dataset.paso);
        boton.disabled = !libre || (paso < 0 ? valor <= min : valor >= max);
      });

      const linea = el.querySelector('[data-precio-linea]');
      if (linea) {
        const unidad = valor === 1 ? el.dataset.singular : el.dataset.plural;
        linea.textContent =
          valor === 0
            ? `${fmtDias(porUnidad)} ${etiquetaDias(porUnidad)} c/u`
            : `${valor} ${unidad} · ${fmtDias(diasPieza)} ${etiquetaDias(diasPieza)} · $${fmt(diasPieza * tarifa)}`;
      }

      if (valor > 0) {
        dias += diasPieza;
        cantidad += 1;
      }
    });

    // Grupos excluyentes.
    const opcionesActivas = new Set();
    grupos.forEach((el) => {
      const idGrupo = el.dataset.id;
      const libre = disponible(idGrupo);
      pintarBloqueo(el, libre);
      if (libre) opcionesActivas.add(seleccion.get(idGrupo));
    });

    opciones.forEach((el) => {
      const elegida = seleccion.get(el.dataset.grupo) === el.dataset.id;
      el.classList.toggle('opcion-activa', elegida);

      const diasOpcion = Number(el.dataset.dias || 0);
      const linea = el.querySelector('[data-precio-linea]');
      if (linea) linea.textContent = `${fmtDias(diasOpcion)} ${etiquetaDias(diasOpcion)} · $${fmt(diasOpcion * tarifa)}`;

      if (elegida && opcionesActivas.has(el.dataset.id)) {
        dias += diasOpcion;
        cantidad += 1;
      }
    });

    // Texto que cambia según la opción elegida.
    variantes.forEach((el) => {
      el.hidden = !opcionesActivas.has(el.dataset.variante);
    });

    // Detalle en orden de página, leyendo el estado ya asentado: las piezas
    // bloqueadas quedaron destildadas más arriba, así que no hay que filtrarlas
    // de nuevo.
    resumen = [];
    totalDias = dias;
    items.forEach((el) => {
      if (el.dataset.tipo === 'toggle' && el.dataset.marcada === 'true') {
        resumen.push({ id: el.dataset.id, nombre: el.dataset.nombre, cantidad: 1, dias: Number(el.dataset.dias || 0) });
        return;
      }
      if (el.dataset.tipo === 'contador') {
        const valor = Number(el.dataset.valor || 0);
        if (valor === 0) return;
        resumen.push({
          id: el.dataset.id,
          nombre: el.dataset.nombre,
          cantidad: valor,
          dias: valor * Number(el.dataset.diasUnidad || 0),
        });
        return;
      }
      if (el.dataset.tipo === 'grupo') {
        const idOpcion = seleccion.get(el.dataset.id);
        if (!opcionesActivas.has(idOpcion)) return;
        const opcion = opciones.find((o) => o.dataset.id === idOpcion);
        if (!opcion) return;
        resumen.push({
          id: opcion.dataset.id,
          nombre: opcion.dataset.nombre,
          cantidad: 1,
          dias: Number(opcion.dataset.dias || 0),
        });
      }
    });

    pintarDocumento();

    if (elCantidad) {
      const etiquetaPieza = cantidad === 1 ? 'pieza elegida' : 'piezas elegidas';
      elCantidad.textContent = `${cantidad} ${etiquetaPieza} · ${fmtDias(dias)} ${etiquetaDias(dias)}`;
    }
    if (elPrecio) {
      elPrecio.textContent = `$${fmt(dias * tarifa)}`;
    }

    sincronizarUrl();
  }

  /**
   * La selección entera va en la URL con replaceState: sobrevive al refresco y
   * el enlace copiado es el presupuesto acordado, sin ensuciar el historial.
   */
  function sincronizarUrl() {
    const params = new URLSearchParams();

    const marcados = toggles.filter((el) => el.dataset.marcada === 'true').map((el) => el.dataset.id);
    params.set('p', marcados.join(','));

    const cuentas = contadores
      .filter((el) => Number(el.dataset.valor) > 0)
      .map((el) => `${el.dataset.id}:${el.dataset.valor}`);
    if (cuentas.length) params.set('n', cuentas.join(','));

    const elegidas = grupos.map((el) => `${el.dataset.id}:${seleccion.get(el.dataset.id)}`);
    if (elegidas.length) params.set('g', elegidas.join(','));

    history.replaceState(null, '', `${location.pathname}?${params}`);
  }

  function restaurarDesdeUrl() {
    const params = new URLSearchParams(location.search);

    const marcados = params.get('p');
    if (marcados !== null) {
      const elegidos = new Set(marcados.split(',').filter(Boolean));
      toggles.forEach((el) => {
        el.dataset.marcada = elegidos.has(el.dataset.id) ? 'true' : 'false';
      });
    }

    const cuentas = params.get('n');
    if (cuentas !== null) {
      const valores = new Map(cuentas.split(',').filter(Boolean).map((par) => par.split(':')));
      contadores.forEach((el) => {
        const crudo = Number(valores.get(el.dataset.id) ?? 0);
        const min = Number(el.dataset.min || 0);
        const max = Number(el.dataset.max || 0);
        el.dataset.valor = String(Math.min(max, Math.max(min, Number.isFinite(crudo) ? crudo : min)));
      });
    }

    const elegidas = params.get('g');
    if (elegidas !== null) {
      elegidas
        .split(',')
        .filter(Boolean)
        .forEach((par) => {
          const [idGrupo, idOpcion] = par.split(':');
          if (seleccion.has(idGrupo) && grupoDeOpcion.get(idOpcion) === idGrupo) {
            seleccion.set(idGrupo, idOpcion);
          }
        });
    }
  }

  toggles.forEach((el) => {
    el.addEventListener('click', () => {
      el.dataset.marcada = el.dataset.marcada === 'true' ? 'false' : 'true';
      recalcular();
    });
  });

  contadores.forEach((el) => {
    el.querySelectorAll('[data-paso]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const paso = Number(boton.dataset.paso);
        const min = Number(el.dataset.min || 0);
        const max = Number(el.dataset.max || 0);
        const valor = Number(el.dataset.valor || 0);
        el.dataset.valor = String(Math.min(max, Math.max(min, valor + paso)));
        recalcular();
      });
    });
  });

  opciones.forEach((el) => {
    el.addEventListener('click', () => {
      seleccion.set(el.dataset.grupo, el.dataset.id);
      recalcular();
    });
  });

  const hoy = new Date();
  if (elDocFecha) {
    elDocFecha.textContent = hoy.toLocaleDateString('es-EC', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  if (elDocNumero) {
    const sello = [hoy.getFullYear(), hoy.getMonth() + 1, hoy.getDate()]
      .map((n, i) => String(n).padStart(i === 0 ? 4 : 2, '0'))
      .join('');
    elDocNumero.textContent = `N.º PS-${sello}`;
  }

  botonImprimir?.addEventListener('click', () => window.print());

  /**
   * El documento ya tiene todas las filas en el marcado: acá solo se tapan las
   * que no se contrataron y se completan días y valores. Una fase sin nada
   * elegido desaparece entera, subtotal incluido.
   */
  function pintarDocumento() {
    const elegido = new Map(resumen.map((r) => [r.id, r]));

    cuerposDoc.forEach((cuerpo) => {
      let diasFase = 0;
      let visibles = 0;

      cuerpo.querySelectorAll('[data-doc-fila]').forEach((fila) => {
        const dato = elegido.get(fila.dataset.id);
        fila.hidden = !dato;
        if (!dato) return;

        visibles += 1;
        diasFase += dato.dias;

        const cantidad = fila.querySelector('[data-doc-cantidad]');
        if (cantidad) cantidad.textContent = dato.cantidad > 1 ? ` ×${dato.cantidad}` : '';
        fila.querySelector('[data-doc-dias]').textContent = fmtDias(dato.dias);
        fila.querySelector('[data-doc-valor]').textContent = `$${fmt(dato.dias * tarifa)}`;
      });

      cuerpo.hidden = visibles === 0;

      const subtotal = cuerpo.querySelector('[data-doc-subtotal]');
      if (subtotal) {
        subtotal.querySelector('[data-doc-dias]').textContent = fmtDias(diasFase);
        subtotal.querySelector('[data-doc-valor]').textContent = `$${fmt(diasFase * tarifa)}`;
      }
    });

    if (elDocTotalDias) elDocTotalDias.textContent = `${fmtDias(totalDias)} ${etiquetaDias(totalDias)}`;
    if (elDocTotalValor) elDocTotalValor.textContent = `$${fmt(totalDias * tarifa)}`;
  }

  function avisar(texto) {
    if (!textoGuardar) return;
    textoGuardar.textContent = texto;
    setTimeout(() => {
      textoGuardar.textContent = 'Guardar selección';
    }, 2600);
  }

  /**
   * La selección no se guarda en ningún lado porque no hace falta: viaja entera
   * en la URL. Guardarla es quedarse con el enlace.
   */
  botonGuardar?.addEventListener('click', async () => {
    if (!resumen.length) {
      avisar('No hay piezas seleccionadas');
      return;
    }

    try {
      await navigator.clipboard.writeText(location.href);
      avisar('Selección guardada en el enlace');
    } catch {
      avisar('Copie el enlace de la barra de direcciones');
    }
  });

  restaurarDesdeUrl();
  recalcular();
</script>
