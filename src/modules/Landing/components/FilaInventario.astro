---
/**
 * Una fila del panel del dueño. Igual que `TarjetaCatalogo`, existe una sola
 * vez y se usa dos: para las filas que ya están y dentro del `<template>` que
 * se clona al dar de alta un libro.
 *
 * El estado —Disponible / Últimas / Agotado— no tiene control propio: sale del
 * stock. Es la idea que el panel tiene que dejar clara de un vistazo.
 */
import {
  CATEGORIAS,
  estadoDe,
  ESTADO_LABEL,
  type ProductoDemo,
} from '../data/catalogo-demo';

interface Props {
  producto: ProductoDemo;
  plantilla?: boolean;
}

const { producto, plantilla = false } = Astro.props;
const estado = estadoDe(producto.stock);
---

<div class="fila-inv" data-fila={plantilla ? undefined : producto.id}>
  {producto.portada ? (
    <img
      src={producto.portada}
      alt=""
      width="36"
      height="44"
      referrerpolicy="no-referrer"
      data-campo="miniatura"
      class="h-11 w-9 shrink-0 rounded-sm object-cover"
    />
  ) : (
    <div
      data-campo="miniatura"
      class="h-11 w-9 shrink-0 rounded-sm"
      style={`background: color-mix(in oklab, var(--color-${producto.tinta}) 35%, var(--color-azul-hondo));`}
    />
  )}

  <div class="col-titulo min-w-0">
    <p data-campo="titulo" class="truncate font-texto text-cuerpo text-agua/90">{producto.titulo}</p>
    <p data-campo="autor" class="truncate font-texto text-menudo text-agua/50">{producto.autor}</p>
  </div>

  <div class="col-controles">
    <label class="campo-inv">
      <span class="sr-only">Categoría de {producto.titulo}</span>
      <select data-editar="categoria" class="control-inv w-full">
        {
          CATEGORIAS.map((categoria) => (
            <option value={categoria} selected={categoria === producto.categoria}>
              {categoria}
            </option>
          ))
        }
      </select>
    </label>

    <label class="campo-inv campo-precio">
      <span class="sr-only">Precio de {producto.titulo}</span>
      <span aria-hidden="true" class="font-texto text-menudo text-agua/45">$</span>
      <input
        type="number"
        inputmode="decimal"
        min="0"
        step="0.5"
        data-editar="precio"
        value={producto.precio.toFixed(2)}
        class="control-inv w-full text-right"
      />
    </label>

    {/* Stock y su consecuencia en la misma celda: el rótulo de abajo cambia
        solo al mover el número, que es justo lo que hay que entender. */}
    <div class="campo-inv campo-stock">
      <div class="flex items-center gap-1">
        <button type="button" data-stock-delta="-1" class="paso-stock" aria-label={`Quitar una unidad de ${producto.titulo}`}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 8h9" /></svg>
        </button>
        <label class="min-w-0 flex-1">
          <span class="sr-only">Unidades de {producto.titulo}</span>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            step="1"
            data-editar="stock"
            value={producto.stock}
            class="control-inv w-full text-center"
          />
        </label>
        <button type="button" data-stock-delta="1" class="paso-stock" aria-label={`Añadir una unidad de ${producto.titulo}`}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3.5v9M3.5 8h9" /></svg>
        </button>
      </div>
      <p data-campo="estado-admin" data-estado={estado} class="rotulo mt-1.5 text-center">
        {ESTADO_LABEL[estado]}
      </p>
    </div>

    <label class="campo-inv">
      <span class="sr-only">Etiqueta de {producto.titulo}</span>
      <select data-editar="etiqueta" class="control-inv w-full">
        <option value="" selected={!producto.etiqueta}>Sin etiqueta</option>
        <option value="nuevo" selected={producto.etiqueta === 'nuevo'}>Nuevo</option>
        <option value="recomendado" selected={producto.etiqueta === 'recomendado'}>Recomendado</option>
      </select>
    </label>
  </div>

  <div class="col-acciones">
    {/* Un libro puede estar en inventario y no querer enseñarlo todavía: eso es
        distinto de estar agotado, y por eso es un interruptor y no un estado. */}
    <button
      type="button"
      data-editar="visible"
      aria-pressed="true"
      class="accion-inv"
      title="Visible en el catálogo"
    >
      <span class="sr-only">Mostrar {producto.titulo} en el catálogo</span>
      <svg class="icono-ojo h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M1.8 10S4.9 4.6 10 4.6 18.2 10 18.2 10 15.1 15.4 10 15.4 1.8 10 1.8 10Z" />
        <circle cx="10" cy="10" r="2.4" />
      </svg>
      <svg class="icono-ojo-tachado hidden h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M3.4 6.3C2.4 7.5 1.8 10 1.8 10s3.1 5.4 8.2 5.4c1.3 0 2.4-.3 3.4-.8" />
        <path d="M7.9 5C8.6 4.7 9.3 4.6 10 4.6c5.1 0 8.2 5.4 8.2 5.4s-.8 1.4-2.2 2.8" />
        <path d="M3 3l14 14" />
      </svg>
    </button>

    <button
      type="button"
      data-editar="borrar"
      class="accion-inv accion-borrar"
      title="Quitar del inventario"
    >
      <span class="sr-only">Quitar {producto.titulo} del inventario</span>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M3.5 5.5h13M8 5.5V3.8h4v1.7M5.4 5.5l.7 10.2h7.8l.7-10.2" />
      </svg>
    </button>
  </div>
</div>

<style>
  /* `:global` porque la cabecera de columnas se pinta en `Catalogo.astro` y
     tiene que caer en la misma rejilla que las filas. Sin esto Astro le pondría
     otro identificador y las columnas no coincidirían. */
  /* Cada fila es su propia rejilla, así que las columnas `auto` no se miden
     entre sí: la de acciones va con ancho fijo —dos botones de 2rem y su
     hueco— porque la cabecera no lleva botones y, si la dejara en `auto`,
     mediría cero y correría todos los rótulos 68px a la derecha. */
  :global(.fila-inv),
  :global(.cabecera-inv) {
    display: grid;
    grid-template-columns: 2.25rem minmax(8rem, 1fr) auto 4.25rem;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-block: 0.75rem;
  }

  :global(.cabecera-inv) {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-agua) 18%, transparent);
  }

  :global(.fila-inv + .fila-inv) {
    border-top: 1px solid color-mix(in oklab, var(--color-agua) 12%, transparent);
  }

  /* Un libro oculto sigue en el inventario: se atenúa, no se va. */
  :global(.fila-inv:has([data-editar='visible'][aria-pressed='false'])) {
    opacity: 0.5;
  }

  :global(.col-controles) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.col-acciones) {
    display: flex;
    gap: 0.25rem;
  }

  :global(.campo-inv) {
    display: block;
    width: 9rem;
  }
  :global(.campo-precio) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    width: 6rem;
  }
  /* Ancho suficiente para que «Últimas unidades» quepa en una línea: si parte
     en dos, esa fila crece y se desalinea de las demás. */
  :global(.campo-stock) {
    width: 10.5rem;
  }

  /* Por debajo del ancho donde caben las siete columnas, los controles se
     bajan enteros a su propia línea en vez de estrujarse. */
  @media (width < 64rem) {
    :global(.fila-inv) {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    }
    /* El orden del DOM pone los controles antes que las acciones, así que aquí
       se colocan a mano: portada, título y acciones comparten la primera línea
       y los controles bajan enteros a la segunda. Sin esto las acciones caen a
       una tercera línea, solas y lejos del libro del que hablan. */
    :global(.col-acciones) {
      grid-column: 3;
      grid-row: 1;
    }
    :global(.col-controles) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    :global(.cabecera-inv) {
      display: none;
    }
  }

  :global(.control-inv) {
    background: color-mix(in oklab, var(--color-agua) 10%, transparent);
    color: var(--color-agua);
    border: 1px solid color-mix(in oklab, var(--color-agua) 20%, transparent);
    border-radius: 10px; /* rounded.etiqueta */
    padding: 0.4rem 0.55rem;
    font-family: var(--font-texto);
    font-size: var(--text-menudo);
    line-height: 1.3;
  }
  :global(.control-inv:focus-visible) {
    outline: 2px solid var(--color-naranja);
    outline-offset: 1px;
  }
  /* El desplegable lo pinta el sistema: sin esto, texto claro sobre fondo claro. */
  :global(.control-inv option) {
    color: var(--color-azul-hondo);
    background: var(--color-agua);
  }
  /* Las flechitas nativas sobran donde ya hay botones de −/+. */
  :global(.control-inv::-webkit-outer-spin-button),
  :global(.control-inv::-webkit-inner-spin-button) {
    appearance: none;
    margin: 0;
  }
  :global(.control-inv[type='number']) {
    -moz-appearance: textfield;
  }

  :global(.paso-stock) {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 9999px; /* rounded.pastilla */
    color: color-mix(in oklab, var(--color-agua) 70%, transparent);
    background: color-mix(in oklab, var(--color-agua) 10%, transparent);
    transition: background-color 200ms var(--ease-gota), color 200ms var(--ease-gota);
  }
  :global(.paso-stock svg) {
    width: 0.85rem;
    height: 0.85rem;
  }
  :global(.paso-stock:hover) {
    background: color-mix(in oklab, var(--color-agua) 20%, transparent);
    color: var(--color-agua);
  }

  :global(.accion-inv) {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px; /* rounded.pastilla */
    color: color-mix(in oklab, var(--color-agua) 55%, transparent);
    transition: background-color 200ms var(--ease-gota), color 200ms var(--ease-gota);
  }
  :global(.accion-inv:hover) {
    background: color-mix(in oklab, var(--color-agua) 12%, transparent);
    color: var(--color-agua);
  }
  :global(.accion-borrar:hover) {
    color: var(--color-naranja);
  }
  :global(.accion-inv[aria-pressed='false'] .icono-ojo) {
    display: none;
  }
  :global(.accion-inv[aria-pressed='false'] .icono-ojo-tachado) {
    display: block;
  }

  /* El estado no se edita: se lee. Por eso es texto y no un control. */
  :global([data-campo='estado-admin'][data-estado='disponible']) {
    color: color-mix(in oklab, var(--color-agua) 55%, transparent);
  }
  :global([data-campo='estado-admin'][data-estado='ultimas']) {
    color: var(--color-naranja);
  }
  :global([data-campo='estado-admin'][data-estado='agotado']) {
    color: color-mix(in oklab, var(--color-agua) 38%, transparent);
  }
</style>
